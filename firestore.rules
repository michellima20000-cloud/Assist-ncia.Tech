rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is a system super administrator
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ['michel.lima20000@gmail.com', 'michel.lima@gmail.com'] ||
        request.auth.token.role == 'superadmin'
      );
    }

    // Helper to check if request belongs to the same tenant company
    function belongsToCompany(companyId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.companyId == companyId
      );
    }

    // Companies directory
    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // System configurations
    match /config/{configId} {
      allow read: if isAuthenticated() || true;
      allow write: if isAuthenticated();
    }

    // Scoped multi-tenant collections (clientes, atendimentos, servicos, produtos, vendas, etc.)
    match /{collectionName}/{docId} {
      allow read: if isAuthenticated() || true;
      allow create: if isAuthenticated() || true;
      allow update, delete: if isAuthenticated() || true;
    }
  }
}

